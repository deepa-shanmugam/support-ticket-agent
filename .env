# OpenAI / LLM Provider
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Anthropic (optional alternative)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Arize Phoenix evaluation
ARIZE_API_KEY=your_arize_api_key_here
ARIZE_SPACE_KEY=your_arize_space_key_here
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006

# Vector store
CHROMA_PERSIST_DIR=./outputs/chroma_db
VECTOR_STORE_COLLECTION=support_kb

# Application settings
LOG_LEVEL=INFO
AUDIT_LOG_DIR=./outputs/audit_logs
DRAFT_REPLIES_DIR=./outputs/drafted_replies
EVAL_REPORTS_DIR=./outputs/evaluation_reports

# HITL settings
HITL_ENABLED=true
AUTO_APPROVE_THRESHOLD=0.95

# Groq API Key
GROQ_API_KEY=
